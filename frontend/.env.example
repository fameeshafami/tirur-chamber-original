# Copy this file to frontend/.env
# Only variables prefixed with VITE_ are exposed to the browser.

# Local dev and preview: leave this as /api. vite.config.js proxies it to http://localhost:5000.
# Production, when the frontend and API are on different hosts: full API origin, no trailing slash.
# Example: VITE_API_URL=https://your-api-host.example/api
VITE_API_URL=/api
